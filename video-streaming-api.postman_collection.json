{
	"info": {
		"_postman_id": "bcf8fa83-9b88-466d-a60d-77112004ea7e",
		"name": "Video Streaming API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Upload Video",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-API-KEY",
						"value": "{{apiKey}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": []
						},
						{
							"key": "title",
							"value": "Coding Reel",
							"type": "text"
						},
						{
							"key": "description",
							"value": "Building a custom video streaming app in Java and React! #dev #programming",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/videos/upload",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"videos",
						"upload"
					]
				},
				"description": "Uploads any video format (MP4, MOV, AVI), storing it in a secure extensionless local path, and mapping its metadata (including custom title and description) to MySQL."
			},
			"response": []
		},
		{
			"name": "List Videos",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-API-KEY",
						"value": "{{apiKey}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/videos/list",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"videos",
						"list"
					]
				},
				"description": "Retrieves the list of video metadata. Real file names and extensions are hidden, returning only the videoKeys."
			},
			"response": []
		},
		{
			"name": "Stream Video",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Range",
						"value": "bytes=0-1048575",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/videos/stream/{{videoKey}}?apiKey={{apiKey}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"videos",
						"stream",
						"{{videoKey}}"
					],
					"query": [
						{
							"key": "apiKey",
							"value": "{{apiKey}}"
						}
					]
				},
				"description": "Streams byte chunks of the video dynamically from MySQL. Uses the HTTP Range header (e.g. bytes=0-1048575) and authorization query parameter."
			},
			"response": []
		},
		{
			"name": "Delete Video",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "X-API-KEY",
						"value": "{{apiKey}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/videos/{{videoKey}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"videos",
						"{{videoKey}}"
					]
				},
				"description": "Cascade deletes both the main video metadata and all related 1MB BLOB chunks from the MySQL database."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "apiKey",
			"value": "e7b065a7d32c4b5e8f1d2c6b0a4e8d32",
			"type": "string"
		},
		{
			"key": "videoKey",
			"value": "8c59123847deef348f1d2c6b0a4e8d32e7b065a7d32c4b5e8f1d2c6b0a4e8d32",
			"type": "string"
		}
	]
}
